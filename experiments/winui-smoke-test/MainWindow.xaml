<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="DevHQ_WinUISmokeTest.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DevHQ_WinUISmokeTest"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="DevHQ"
    mc:Ignorable="d">

    <!-- The web app is flat, not translucent, so there is no backdrop here:
         the title bar sits on bg1 and the body on bg, exactly as in the CSS. -->
    <Grid x:Name="Shell" Background="{ThemeResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{ThemeResource Bg1Brush}" BorderBrush="{ThemeResource LineBrush}"
                BorderThickness="0,0,0,1">
            <TitleBar x:Name="AppTitleBar" Title="DevHQ" Subtitle="native shell experiment">
                <TitleBar.IconSource>
                    <ImageIconSource ImageSource="Assets/AppIcon.ico" />
                </TitleBar.IconSource>
                <TitleBar.RightHeader>
                    <Button x:Name="ThemeToggle" Click="ThemeToggle_Click"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{ThemeResource DimBrush}" Padding="12,6"
                            ToolTipService.ToolTip="Switch between the light and dark palette">
                        <FontIcon Glyph="&#xE706;" FontSize="16" />
                    </Button>
                </TitleBar.RightHeader>
            </TitleBar>
        </Border>

        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
