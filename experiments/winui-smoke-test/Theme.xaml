                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource OnFillBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource AccentBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource OnTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource OnFillBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource AccentBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource OnTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
