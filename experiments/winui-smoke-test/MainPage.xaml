<?xml version="1.0" encoding="utf-8" ?>
<!--
  The DevHQ overview, drawn natively: toolbar, summary strip, filter chips,
  the card grid, and the status bar that is never empty. It is a look, not a
  working app - the data is fixed and the buttons do nothing.
-->
<Page x:Class="DevHQ_WinUISmokeTest.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DevHQ_WinUISmokeTest"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Background="{ThemeResource BgBrush}">

    <Page.Resources>
        <!-- ~~~~~ one project card ~~~~~ -->
        <DataTemplate x:Key="CardTemplate" x:DataType="local:Project">
            <Border Background="{ThemeResource Bg1Brush}"
                    BorderBrush="{ThemeResource LineBrush}" BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <!-- The stripe that says dirty, running, or both. -->
                    <Rectangle Width="3" HorizontalAlignment="Left" Fill="{x:Bind Stripe}" />

                    <StackPanel Padding="13,13,14,13" Spacing="9">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                <Border Background="{ThemeResource Bg3Brush}" CornerRadius="5" Padding="5,2"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind HasVersion}">
                                    <TextBlock Text="{x:Bind VersionLabel}" FontSize="11"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{ThemeResource Dim2Brush}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5"
                                        VerticalAlignment="Center" Visibility="{x:Bind IsRunning}">
                                <Ellipse Width="7" Height="7" Fill="{ThemeResource GreenBrush}" />
                                <TextBlock Text="{x:Bind RunningLabel}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{ThemeResource GreenBrush}" />
                            </StackPanel>
                        </Grid>

                        <!-- the technologies, coloured by what kind of thing they are -->
                        <ItemsControl ItemsSource="{x:Bind Tech}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <local:WrapPanel HorizontalSpacing="5" VerticalSpacing="5" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:TechTag">
                                    <Border Background="{x:Bind Background}" CornerRadius="6" Padding="7,2.5">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{x:Bind Name}" FontSize="11" FontWeight="Medium"
                                                       Foreground="{x:Bind Foreground}" />
                                            <TextBlock Text="{x:Bind Version}" FontSize="10" Opacity="0.72"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{x:Bind Foreground}"
                                                       Visibility="{x:Bind HasVersion}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{x:Bind Description}" FontSize="12.5" LineHeight="18"
                                   Foreground="{ThemeResource DimBrush}"
                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />

                        <!-- branch, changes, ports: the glanceable line -->
                        <ItemsControl ItemsSource="{x:Bind Stats}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <local:WrapPanel HorizontalSpacing="12" VerticalSpacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:Stat">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="13"
                                                  Foreground="{x:Bind Foreground}" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind Text}" FontSize="12"
                                                   Foreground="{x:Bind Foreground}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- the last commit, ruled off from the body -->
                        <Border BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE81C;" FontSize="13" Foreground="{ThemeResource Dim2Brush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind CommitHash}" FontSize="11.5"
                                           FontFamily="{StaticResource MonoFont}"
                                           Foreground="{ThemeResource Dim2Brush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind CommitSubject}" FontSize="11.5"
                                           Foreground="{ThemeResource Dim2Brush}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Text="{x:Bind CommitAge}" FontSize="11.5"
                                           Foreground="{ThemeResource Dim2Brush}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- what the card lets you do -->
                        <Border BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,9,0,0">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource CardAction}" IsEnabled="{x:Bind CanRun}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="{ThemeResource GreenBrush}" />
                                        <TextBlock Text="Run" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Style="{StaticResource CardAction}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE943;" FontSize="14" />
                                        <TextBlock Text="Code" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Style="{StaticResource CardAction}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE756;" FontSize="14" />
                                        <TextBlock Text="Terminal" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ~~~~~ toolbar: where you are, and what you are looking for ~~~~~ -->
        <Border Background="{ThemeResource Bg1Brush}" BorderBrush="{ThemeResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="16,12">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="{ThemeResource Bg2Brush}" BorderBrush="{ThemeResource LineBrush}"
                        BorderThickness="1" CornerRadius="9" Height="34">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton Style="{StaticResource Segment}" IsChecked="True" BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE80F;" FontSize="15" />
                                <TextBlock Text="Overview" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource Segment}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7C4;" FontSize="15" />
                                <TextBlock Text="Processes" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{ThemeResource Bg2Brush}"
                        BorderBrush="{ThemeResource LineBrush}" BorderThickness="1"
                        CornerRadius="9" Height="34" Padding="10,0">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE721;" FontSize="16" Foreground="{ThemeResource Dim2Brush}"
                                  VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Style="{StaticResource BareTextBox}"
                                 PlaceholderText="Search projects and commands..." />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ~~~~~ summary strip: the three numbers that matter ~~~~~ -->
        <Border Grid.Row="1" Background="{ThemeResource BgBrush}" BorderBrush="{ThemeResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="16,9">
            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Ellipse Width="7" Height="7" Fill="{ThemeResource GreenBrush}" VerticalAlignment="Center" />
                        <TextBlock FontSize="12.5" Foreground="{ThemeResource Dim2Brush}">
                            <Run Text="3" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                            <Run Text="running" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Ellipse Width="7" Height="7" Fill="{ThemeResource AmberBrush}" VerticalAlignment="Center" />
                        <TextBlock FontSize="12.5" Foreground="{ThemeResource Dim2Brush}">
                            <Run Text="3" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                            <Run Text="with uncommitted changes (" />
                            <Run Text="23" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                            <Run Text=" files)" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Ellipse Width="7" Height="7" Fill="{ThemeResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock FontSize="12.5" Foreground="{ThemeResource Dim2Brush}">
                            <Run Text="2" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                            <Run Text="unpushed" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="scanned at 14:02:31" FontSize="12.5"
                           Foreground="{ThemeResource Dim2Brush}" VerticalAlignment="Center"
                           HorizontalAlignment="Right" Margin="0,0,8,0" />

                <Button Grid.Column="2" Style="{StaticResource RootChip}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{ThemeResource Dim2Brush}" />
                        <TextBlock Text="C:\code" FontFamily="{StaticResource MonoFont}" />
                        <FontIcon Glyph="&#xE70F;" FontSize="14" Foreground="{ThemeResource Dim2Brush}" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Height="29" Padding="10,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Rescan" FontSize="12" />
                    </StackPanel>
                </Button>

                <Border Grid.Column="4" Background="{ThemeResource Bg2Brush}"
                        BorderBrush="{ThemeResource LineBrush}" BorderThickness="1"
                        CornerRadius="9" Height="29">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton Style="{StaticResource Segment}" IsChecked="True" BorderThickness="0"
                                      FontSize="11.5" Padding="8,0" Content="Recent" />
                        <ToggleButton Style="{StaticResource Segment}" FontSize="11.5" Padding="8,0" Content="Name" />
                        <ToggleButton Style="{StaticResource Segment}" FontSize="11.5" Padding="8,0" Content="Changes" />
                        <ToggleButton Style="{StaticResource Segment}" FontSize="11.5" Padding="8,0" Content="Running" />
                        <ToggleButton Style="{StaticResource Segment}" FontSize="11.5" Padding="8,0" Content="Tech" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="5" Background="{ThemeResource Bg2Brush}"
                        BorderBrush="{ThemeResource LineBrush}" BorderThickness="1"
                        CornerRadius="9" Height="29">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton Style="{StaticResource Segment}" IsChecked="True" BorderThickness="0"
                                      FontSize="11.5" Padding="8,0" Content="Cards" />
                        <ToggleButton Style="{StaticResource Segment}" FontSize="11.5" Padding="8,0" Content="Table" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ~~~~~ filter chips ~~~~~ -->
        <Border Grid.Row="2" Background="{ThemeResource BgBrush}" BorderBrush="{ThemeResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource Chip}" IsChecked="True">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Uncommitted" />
                            <TextBlock Text="3" Foreground="{ThemeResource Dim2Brush}" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource Chip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Running" />
                            <TextBlock Text="3" Foreground="{ThemeResource Dim2Brush}" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource Chip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Unpushed" />
                            <TextBlock Text="2" Foreground="{ThemeResource Dim2Brush}" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource Chip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Behind" />
                            <TextBlock Text="1" Foreground="{ThemeResource Dim2Brush}" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource Chip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Stashed" />
                            <TextBlock Text="1" Foreground="{ThemeResource Dim2Brush}" />
                        </StackPanel>
                    </ToggleButton>
                    <Rectangle Width="1" Height="18" Fill="{ThemeResource LineBrush}" Margin="3,0" />
                    <ToggleButton Style="{StaticResource Chip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE894;" FontSize="13" />
                            <TextBlock Text="Clear" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource ToolButton}" Height="29"
                        Background="{ThemeResource Bg2Brush}" Foreground="{ThemeResource DimBrush}"
                        Padding="8,0" FontSize="12" FontWeight="Normal">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE71C;" FontSize="14" Foreground="{ThemeResource Dim2Brush}" />
                        <TextBlock Text="All tech" />
                        <FontIcon Glyph="&#xE70D;" FontSize="12" Foreground="{ThemeResource Dim2Brush}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ~~~~~ the grid of projects ~~~~~ -->
        <ScrollViewer Grid.Row="3" Padding="16" HorizontalScrollMode="Disabled">
            <muxc:ItemsRepeater x:Name="Cards" ItemTemplate="{StaticResource CardTemplate}">
                <muxc:ItemsRepeater.Layout>
                    <muxc:UniformGridLayout MinItemWidth="330" MinItemHeight="0"
                                            MinColumnSpacing="12" MinRowSpacing="12"
                                            ItemsStretch="Fill" />
                </muxc:ItemsRepeater.Layout>
            </muxc:ItemsRepeater>
        </ScrollViewer>

        <!-- ~~~~~ status bar: never empty, never hidden ~~~~~ -->
        <Border Grid.Row="4" Background="{ThemeResource Bg1Brush}" BorderBrush="{ThemeResource LineBrush}"
                BorderThickness="0,1,0,0" Height="36">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="7" Padding="16,0" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{ThemeResource Dim2Brush}" />
                    <TextBlock Text="Read 6 projects" FontSize="12.5" Foreground="{ThemeResource TextBrush}" />
                    <Border Background="{ThemeResource Bg3Brush}" CornerRadius="5" Padding="7,2">
                        <TextBlock Text="6 / 6" FontSize="11.5" FontFamily="{StaticResource MonoFont}"
                                   Foreground="{ThemeResource Dim2Brush}" />
                    </Border>
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource StatusButton}" Padding="12,0"
                        FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="Normal"
                        Foreground="{ThemeResource Dim2Brush}" Content="v0.12.0" />

                <Button Grid.Column="2" Style="{StaticResource StatusButton}" Click="ToggleDock_Click">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE756;" FontSize="16" />
                        <TextBlock Text="Terminal" />
                        <TextBlock Text="2" FontSize="11" FontWeight="Normal"
                                   FontFamily="{StaticResource MonoFont}"
                                   Foreground="{ThemeResource Dim2Brush}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!--
          ~~~~~ the terminal dock ~~~~~
          Below the status bar, as on the web, and in the terminal's own
          colours rather than the window's. The transcript is canned; the
          prompt at the bottom is a real field, so what a native text control
          does with a caret and a selection can be felt rather than guessed at.
        -->
        <Grid x:Name="Dock" Grid.Row="5" Height="280" Background="{StaticResource TermBg}"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="5" />
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- the grip you drag the dock taller by -->
            <Border Background="{StaticResource TermLine}" Height="1" VerticalAlignment="Top" />
            <Border x:Name="DockGrip" Background="Transparent" ManipulationMode="TranslateY"
                    ManipulationDelta="DockGrip_ManipulationDelta"
                    PointerEntered="DockGrip_PointerEntered" PointerExited="DockGrip_PointerExited" />

            <Border Grid.Row="1" Background="{StaticResource TermBar}"
                    BorderBrush="{StaticResource TermLine}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
                        <ToggleButton Style="{StaticResource DockTab}" IsChecked="True">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Border BorderBrush="{StaticResource TermBlue}" BorderThickness="1"
                                        CornerRadius="4" Height="16" MinWidth="22" Padding="4,0">
                                    <TextBlock Text="PW7" FontSize="8" FontWeight="ExtraBold"
                                               Foreground="{StaticResource TermBlue}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Ellipse Width="6" Height="6" Fill="{StaticResource TermGreen}" />
                                <TextBlock Text="devhq" />
                                <FontIcon Glyph="&#xE711;" FontSize="12"
                                          Foreground="{StaticResource TermDim2}" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource DockTab}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Border BorderBrush="{StaticResource TermBrightBlue}" BorderThickness="1"
                                        CornerRadius="4" Height="16" MinWidth="22" Padding="4,0">
                                    <TextBlock Text="PS" FontSize="8" FontWeight="ExtraBold"
                                               Foreground="{StaticResource TermBrightBlue}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Ellipse Width="6" Height="6" Fill="{StaticResource TermGreen}" />
                                <TextBlock Text="showdown-tv" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Border BorderBrush="{StaticResource TermLine}" BorderThickness="0,0,1,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource DockAction}"
                                        ToolTipService.ToolTip="New terminal">
                                    <FontIcon Glyph="&#xE710;" FontSize="16" />
                                </Button>
                                <Button Style="{StaticResource DockAction}" Width="26"
                                        ToolTipService.ToolTip="Choose terminal type">
                                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource DockAction}"
                                ToolTipService.ToolTip="Pop out this terminal">
                            <FontIcon Glyph="&#xE8A7;" FontSize="16" />
                        </Button>
                        <Button Style="{StaticResource DockAction}"
                                ToolTipService.ToolTip="Close this terminal">
                            <FontIcon Glyph="&#xE74D;" FontSize="16" />
                        </Button>
                        <Border BorderBrush="{StaticResource TermLine}" BorderThickness="1,0,0,0">
                            <Button Style="{StaticResource DockAction}" Click="ToggleDock_Click"
                                    ToolTipService.ToolTip="Hide the panel">
                                <FontIcon Glyph="&#xE70D;" FontSize="16" />
                            </Button>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer x:Name="TermScroll" Grid.Row="2" Padding="8,6"
                          HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="TermLines" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
