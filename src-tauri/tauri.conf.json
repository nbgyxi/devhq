{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevHQ",
  "version": "0.1.1",
  "identifier": "com.devhq.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DevHQ",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "center": true,
        "backgroundColor": "#0c0d11"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "DevHQ - developer overview of your projects",
    "longDescription": "DevHQ scans a folder of development projects and reports git status, running processes, detected tech stack and versions at a glance."
  }
}
