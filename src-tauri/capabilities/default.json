{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the WinT window and any popped-out terminal, tool or workspace. A window label absent from this list gets no core permissions at all - not even event listening - so its page dies on its first call.",
  "windows": ["main", "term-*", "tool-*", "workspace-*", "global-search", "clipboard-picker", "version-history"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "core:window:allow-set-always-on-top",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-outer-position",
    "core:window:allow-inner-position",
    "core:window:allow-inner-size",
    "core:window:allow-set-size",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "core:window:allow-hide",
    "opener:default"
  ]
}
